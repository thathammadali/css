# Copy this file to .env in the repository root and fill in real values.
# Never commit .env.

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=sems_user
POSTGRES_PASSWORD=SEMS@2026
POSTGRES_DB=sems_db

# --- Authentication ---
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend will not start without it.
JWT_SECRET=UMT_KUST_CSS_SEMS_2026
# How long a login lasts, in minutes (optional, the app has a default)
ACCESS_TOKEN_MINUTES=60

# --- CORS ---
# Comma-separated list of frontend addresses allowed to call the API in production,
# for example: https://sems.example.com
# Localhost addresses are always allowed for development.
CORS_ORIGINS=